#how many people would die due to a disease sampling in the same place were matteo was counting animals 
elisa <- c(100, 80, 50, 20, 10) #an array of human deaths due to a disease
#graphical plot putting of X = number of species found by mattero, Y = number of death found by elisa
plot (matteo,elisa)
#there's an exponential decrease of human deaths while there's a increase of number of animals (no correll)
#let's prettyfy our plot - the symbol in R is called point.character, every single symbol is stored inside R with a label (closed black circle, code number 19) 
#anacronym used: pch = 19, point caracter and the number of symbol I want to use 
plot(matteo,elisa,pch=19)
#problem of the chart: the points are too small 
# GLOSSARY Methods Ecol Evol - commit: saving results and scripts - button: commit changes, or command S for Mac 
# character exaggeration 
plot (matteo, elisa, pch=19, cex=2)  #doubled
plot (matteo, elisa, pch=19, cex=4) 
#up + arrow : previous command 
#half the dimension cex=0.5 
plot (matteo, elisa, pch=19, cex=0.5) 
plot (matteo, elisa, pch=19, cex=.5) 
#color or col argument for colour
plot (matteo, elisa, pch=19, cex=2, col="blue")
plot (matteo, elisa, pch=19, cex=2, col="chartreuse")
#super ugly to see elisa and matteo in x and y axis: labels of axes
#changing the number of the labels and the name of the label 
plot (matteo, elisa, pch=19, cex=2, col="chartreuse", xlab="number of mammals", ylab= "number of human deaths")
cex.lab = 1.5,   # xlab and ylab size
cex.axis = 1.3   # axis numbers/tick labels size
plot (matteo, elisa, pch=19, cex=2, col="chartreuse", xlab="number of mammals", ylab= "number of human deaths", cex.lab = 1.5)
plot (matteo, elisa, pch=19, cex=2, col="chartreuse", xlab="number of mammals", ylab= "number of human deaths"), cex.axis = 1.3)   # axis numbers/tick labels size
